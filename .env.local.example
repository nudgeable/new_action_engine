# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: email that always gets superadmin role (default: admin@actionengine)
# SUPERADMIN_EMAIL=admin@actionengine

# Required for superadmin user creation (Phase 2b)
# Get this from Supabase Dashboard > Settings > API > service_role key
# WARNING: Keep this secret! Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
NEXT_PUBLIC_APP_URL=https://nudgeable-action-engine.vercel.app

# Optional, testing only — NEVER set in production. Points email links and the
# auto-login redirect at this origin instead of https://practice.nudgeable.ai,
# so a reminder email's "Mark done" can be tested end to end locally/on a preview.
# NUDGEABLE_APP_URL=http://localhost:3000

# Optional: powers the admin Dashboard's email engagement section
# (app/api/webhooks/resend/route.ts). Requires you to separately:
#   1. Enable "Open Tracking" AND "Click Tracking" in the Resend dashboard.
#   2. Add a webhook endpoint pointing at https://<your-host>/api/webhooks/resend,
#      subscribed to at least "email.opened" and "email.clicked".
#   3. Paste that webhook's signing secret (starts with whsec_) here.
# Opens/clicks only start counting from when this is configured — see docs/EMAIL_FEATURE_GUIDE.md.
RESEND_WEBHOOK_SECRET=whsec_xxxxxx

# Optional: WhatsApp Cloud API webhook (app/api/webhooks/whatsapp/route.ts) —
# see docs/WHATSAPP_REMINDERS_PLAN.md. In the Meta App Dashboard → WhatsApp →
# Configuration, set the callback URL to https://<your-host>/api/webhooks/whatsapp
# with the verify token below, and subscribe to the "messages" field.
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN: any random string you choose; must match the dashboard.
#   WHATSAPP_APP_SECRET: App settings → Basic → App secret. Every POST is rejected without it.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=xxxxxx
WHATSAPP_APP_SECRET=xxxxxx
# WhatsApp reminders (Phase 2+). The WhatsApp checkbox in plan setup and the card on
# My Actions → Plan overview stay hidden until WHATSAPP_PHONE_NUMBER_ID is set.
#   WHATSAPP_PHONE_NUMBER_ID: the registered business number's id (WhatsApp Manager / API Setup).
#   WHATSAPP_ACCESS_TOKEN: a system user token with whatsapp_business_messaging. Optional until
#     reminders are sent (Phase 4); without it STOP/START still work but no confirmation is replied.
WHATSAPP_PHONE_NUMBER_ID=xxxxxx
WHATSAPP_ACCESS_TOKEN=xxxxxx

# Get an API key at https://aistudio.google.com/apikey
# Used to generate personal actions from the user's training answers (Gemini Flash),
# including the background batch job that fills out a full multi-week plan.
GEMINI_API_KEY=xxxxxx

# Optional: also protects app/api/generate-actions-batch (the background action-plan
# generator) in addition to the cron endpoint. Vercel sets this automatically when
# the env var is present; for local testing pass ?secret= or an Authorization header.
# CRON_SECRET=xxxxxx